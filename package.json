    "@rspack/core": "^2.1.4",
    "@rspack/dev-server": "^2.1.0",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "css-loader": "^7.1.4",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "react-refresh": "^0.18.0",
